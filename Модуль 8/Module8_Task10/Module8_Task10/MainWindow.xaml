<Window x:Class="Module8_Task10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет задач и событий" Height="480" Width="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <!-- Список задач -->
        <DataGrid x:Name="DgTasks" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionChanged="DgTasks_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35"/>
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Создано" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy\}}" Width="85"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Блок календаря и переключения фильтров -->
        <StackPanel Grid.Column="1" Margin="0,0,10,0" Width="190">
            <TextBlock x:Name="TxtFilterMode" Text="Фильтр: по сроку" FontWeight="Bold" Margin="0,0,0,5"/>
            <Calendar x:Name="TaskCalendar" SelectedDatesChanged="TaskCalendar_SelectedDatesChanged" Margin="0,0,0,10"/>
            <Button Content="Фильтровать по сроку" Height="26" Margin="0,0,0,5" Click="BtnFilterDue_Click"/>
            <Button Content="Фильтровать по созданию" Height="26" Margin="0,0,0,5" Click="BtnFilterCreated_Click"/>
            <Button Content="Сбросить фильтр" Height="26" Click="BtnResetFilter_Click"/>
        </StackPanel>

        <!-- Панель ввода и управления -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Название задачи:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtTitle" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtDescription" Height="55" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

            <TextBlock Text="Статус:" FontWeight="Bold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CmbStatus" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="Новая" IsSelected="True"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Завершена"/>
            </ComboBox>

            <TextBlock Text="Срок выполнения:" FontWeight="Bold" Margin="0,0,0,3"/>
            <DatePicker x:Name="DpDueDate" Height="25" Margin="0,0,0,15"/>

            <Button Content="Добавить" Height="30" Margin="0,0,0,5" Click="BtnAdd_Click"/>
            <Button Content="Обновить" Height="30" Margin="0,0,0,5" Click="BtnUpdate_Click"/>
            <Button Content="Удалить" Height="30" Margin="0,0,0,5" Click="BtnDelete_Click"/>
            <Button Content="Очистить поля" Height="25" Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Window>