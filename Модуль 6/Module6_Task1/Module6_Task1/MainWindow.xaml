<Window x:Class="Module6_Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет сотрудников" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="DgEmployees" AutoGenerateColumns="False" CanUserAddRows="False" 
                  SelectionChanged="DgEmployees_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="120"/>
                <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="100"/>
                <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="ФИО сотрудника:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtFullName" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Должность:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtPosition" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Отдел:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtDepartment" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Зарплата:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtSalary" Height="25" Margin="0,0,0,15"/>

            <Button Content="Добавить" Height="30" Margin="0,0,0,5" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" Height="30" Margin="0,0,0,5" Click="BtnUpdate_Click"/>
            <Button Content="Удалить" Height="30" Margin="0,0,0,5" Click="BtnDelete_Click"/>
            <Button Content="Очистить поля" Height="25" Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Window>