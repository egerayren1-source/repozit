<Window x:Class="Module6_Task4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет финансов" Height="450" Width="750" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="DgTransactions" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionChanged="DgTransactions_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="70"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding TransactionDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Тип:" FontWeight="Bold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CmbType" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="Доход" IsSelected="True"/>
                <ComboBoxItem Content="Расход"/>
            </ComboBox>

            <TextBlock Text="Категория:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtCategory" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Сумма (руб):" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtAmount" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Дата:" FontWeight="Bold" Margin="0,0,0,3"/>
            <DatePicker x:Name="DpDate" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Комментарий:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtComment" Height="40" TextWrapping="Wrap" Margin="0,0,0,15"/>

            <Button Content="Добавить" Height="30" Margin="0,0,0,5" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" Height="30" Margin="0,0,0,5" Click="BtnUpdate_Click"/>
            <Button Content="Очистить" Height="25" Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Window>