<Window x:Class="Module6_Task2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет задач" Height="450" Width="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="DgTasks" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionChanged="DgTasks_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35"/>
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Название задачи:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtTitle" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

            <TextBlock Text="Статус:" FontWeight="Bold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CmbStatus" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="Новая" IsSelected="True"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Завершена"/>
            </ComboBox>

            <TextBlock Text="Срок выполнения:" FontWeight="Bold" Margin="0,0,0,3"/>
            <DatePicker x:Name="DpDueDate" Height="25" Margin="0,0,0,15"/>

            <Button Content="Добавить" Height="30" Margin="0,0,0,5" Click="BtnAdd_Click"/>
            <Button Content="Обновить" Height="30" Margin="0,0,0,5" Click="BtnUpdate_Click"/>
            <Button Content="Удалить" Height="30" Margin="0,0,0,5" Click="BtnDelete_Click"/>
            <Button Content="Очистить" Height="25" Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Window>