<Window x:Class="Module6_Task3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека - Поиск и аренда книг" Height="450" Width="750" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
            <TextBox x:Name="TxtSearch" Width="400" Height="25" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
            <Button Content="Сбросить" Width="80" Height="25" Margin="10,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>

        <DataGrid x:Name="DgBooks" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="1.5*"/>
                <DataGridTextColumn Header="Год" Binding="{Binding YearPublished}" Width="60"/>
                <DataGridCheckBoxColumn Header="Доступна" Binding="{Binding IsAvailable}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Взять в аренду" Width="130" Height="30" Margin="0,0,10,0" Click="BtnRent_Click" Background="#4CAF50" Foreground="White"/>
            <Button Content="Вернуть книгу" Width="130" Height="30" Click="BtnReturn_Click" Background="#2196F3" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>