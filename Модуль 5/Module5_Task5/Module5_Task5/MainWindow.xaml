<Window x:Class="Module5_Task5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Розовый Калькулятор" Height="400" Width="310" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#FFF9F9F9">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="TxtDisplay" Grid.Row="0" Text="0" FontSize="26" TextAlignment="Right" 
                 IsReadOnly="True" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,10"
                 Background="White" BorderBrush="#FFFFB6C1" BorderThickness="1"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="7" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Content="8" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="0" Grid.Column="2" Content="9" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="0" Grid.Column="3" Content="/" FontSize="18" Margin="3" Background="#FFFFB6C1" Foreground="White" FontWeight="Bold" Click="BtnOperation_Click"/>

            <Button Grid.Row="1" Grid.Column="0" Content="4" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Content="*" FontSize="18" Margin="3" Background="#FFFFB6C1" Foreground="White" FontWeight="Bold" Click="BtnOperation_Click"/>

            <Button Grid.Row="2" Grid.Column="0" Content="1" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="2" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="3" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="2" Grid.Column="3" Content="-" FontSize="18" Margin="3" Background="#FFFFB6C1" Foreground="White" FontWeight="Bold" Click="BtnOperation_Click"/>

            <Button Grid.Row="3" Grid.Column="0" Content="C" FontSize="18" Margin="3" Background="#FFFFE4E1" Click="BtnClear_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="0" FontSize="18" Margin="3" Background="#FFFFC0CB" Click="BtnNumber_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="=" FontSize="18" Margin="3" Background="#FFFF69B4" Foreground="White" FontWeight="Bold" Click="BtnEquals_Click"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" FontSize="18" Margin="3" Background="#FFFFB6C1" Foreground="White" FontWeight="Bold" Click="BtnOperation_Click"/>
        </Grid>
    </Grid>
</Window>